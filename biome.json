{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/tsconfig.*.json", "!**/src/gen"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off",
        "useConst": "off",
        "useSingleVarDeclarator": "off",
        "useNumberNamespace": "off",
        "noUnusedTemplateLiteral": "off"
      },
      "correctness": {
        "noSwitchDeclarations": "off"
      },
      "suspicious": {
        "noFallthroughSwitchClause": "off"
      }
    }
  }
}
