{
  "name": "@bufbuild/protoc-gen-grpc-es",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "description": "Protobuf code generator for @grpc/grpc-js",
  "keywords": [
    "protobuf",
    "schema",
    "typescript",
    "ecmascript",
    "grpc",
    "grpc-js",
    "protoc",
    "protoc-plugin"
  ],
  "homepage": "https://github.com/bufbuild/protoc-gen-grpc-es",
  "repository": {
    "type": "git",
    "url": "https://github.com/bufbuild/protoc-gen-grpc-es.git"
  },
  "bin": {
    "protoc-gen-grpc-es": "bin/protoc-gen-grpc-es"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "all": "npm run build && npm run generate && npm run test && npm run lint && npm run format && npm run license-header",
    "prebuild": "rm -rf ./dist/cjs/*",
    "build": "tsc --project tsconfig.json --outDir ./dist/cjs",
    "pregenerate": "rm -rf src/gen/*",
    "generate": "buf generate",
    "postgenerate": "license-header src/gen",
    "pretest": "tsc --project tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "format": "biome format --write",
    "license-header": "license-header",
    "lint": "biome lint --error-on-warnings"
  },
  "preferUnplugged": true,
  "licenseHeader": {
    "licenseType": "apache",
    "yearRange": "2026",
    "copyrightHolder": "Buf Technologies, Inc."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protoplugin": "2.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/license-header": "^0.0.4",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.13.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "files": [
    "dist/**",
    "bin/**"
  ]
}
